# ─────────────────────────────────────────────────────────────
# Gaash Tours & Events — environment variables
# Copy to .env.local and fill in. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3700

# Supabase (Phase 2 — database + admin auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (Phase 3 — payments). Keys prefixed rzp_test_ / rzp_live_
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Resend (transactional email for enquiry/booking confirmations)
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=info@gaashtoursandevent.com
ENQUIRY_FROM_EMAIL=Gaash Tours <bookings@gaashtoursandevent.com>
